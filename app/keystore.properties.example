# ==============================================================================
# GABARIT DE CONFIGURATION DE SIGNATURE ANDROID RELEASE (J7.5b)
# ==============================================================================
# Copiez ce fichier sous 'app/keystore.properties' (non suivi par Git)
# et remplacez les valeurs ci-dessous par vos accès réels de keystore.
#
# NE COMMITEZ JAMAIS LE FICHIER 'app/keystore.properties' REEL DANS GIT !
# ==============================================================================

storeFile=release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
